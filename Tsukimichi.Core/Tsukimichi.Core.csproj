<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tsukimichi.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only seams (e.g. ShareCode.Apply's stand-in Offered flags) stay internal. -->
    <InternalsVisibleTo Include="Tsukimichi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Moonfall's shipped levels (plan v9 G1, G6), read by MoonfallCampaigns.LoadBuiltIn. -->
    <EmbeddedResource Include="Moonfall\Levels\*.json" />
    <!-- Moonfall's modes data (plan v9 G7): the challenges and the Ace scores. -->
    <EmbeddedResource Include="Moonfall\Modes\*.json" />
  </ItemGroup>

</Project>
