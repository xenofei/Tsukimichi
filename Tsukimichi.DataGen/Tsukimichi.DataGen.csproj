<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tsukimichi.DataGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lumina" Version="7.7.1" />
    <PackageReference Include="Lumina.Excel" Version="7.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The portrait pack's head finder and per-NPC boxes are unit-tested (Tsukimichi.Tests/Portraits/PortraitPackBuildTests.cs). -->
    <InternalsVisibleTo Include="Tsukimichi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tsukimichi.Core\Tsukimichi.Core.csproj" />
    <ProjectReference Include="..\Tsukimichi.GameData\Tsukimichi.GameData.csproj" />
  </ItemGroup>

</Project>
