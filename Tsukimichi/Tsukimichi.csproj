<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.22.1.0</Version>
    <Author>Michiru Tsukikage</Author>
    <Name>Tsukimichi</Name>
    <Punchline>Walk the moon's path: every quest, every requirement, every unique reward.</Punchline>
    <Description>A quest catalog for every journal type, with completed and available filters and a per-requirement breakdown of what still blocks a quest.
Moonlit treasures collects quests with unique rewards, and per-character snapshots keep the whole account in view.
Local only: no network code.</Description>
    <RepoUrl>https://github.com/xenofei/Tsukimichi</RepoUrl>
    <!-- Dalamud reads the installer icon from the plugin's own manifest (DalamudPackager maps IconUrl to it), not from pluginmaster.json. -->
    <IconUrl>https://raw.githubusercontent.com/xenofei/Tsukimichi/main/assets/icon-medallion.png</IconUrl>
    <Tags>quests;journal;tracker;rewards</Tags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Michiru Tsukikage</Copyright>
    <RootNamespace>Tsukimichi</RootNamespace>
    <!--
      The game version (ffxivgame.ver) the game hooks were play-tested on: the item tooltip panel, the item and NPC
      context-menu entries and the server info bar entry pause themselves on a newer game (Core/Runtime/HookGate.cs)
      until a release bumps this. Set it with tools/set-tested-version.ps1 on patch day (CONTRIBUTING.md); the release
      workflow refuses a tag whose value is empty.
    -->
    <TsukimichiTestedGameVersion>2026.09.15.0000.0000</TsukimichiTestedGameVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Read at load by DiagnosticBuilder.TestedGameVersionText() for the hook gate. -->
    <AssemblyMetadata Include="TestedGameVersion" Value="$(TsukimichiTestedGameVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Moonfall's sound (plan v9 G8): NAudio (MIT, the owner's approved dependency), only its WASAPI output and its core
      (the mixer); the rest of NAudio (ASIO, MIDI, WinForms, WinMM) stays out. Its DLLs are copied beside the plugin and
      packed into latest.zip with it. The sounds themselves are synthesised in Core (Moonfall/Sound/).
    -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tsukimichi.Core\Tsukimichi.Core.csproj" />
    <ProjectReference Include="..\Tsukimichi.GameData\Tsukimichi.GameData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Moon Road art (docs/design/moon-road/): the ornament atlas (Ui\OrnamentAtlas.cs, layout in Core/Ui/OrnamentLayout.cs)
      and the bundled category banners (Ui\BannerArtwork.cs). Embedded, so they travel inside Tsukimichi.dll and load
      through ITextureProvider.GetFromManifestResource by these names; the layout JSON stays a build-time reference.
    -->
    <EmbeddedResource Include="assets\ui\ornaments.png" LogicalName="Tsukimichi.assets.ui.ornaments.png" />
    <EmbeddedResource Include="assets\ui\ornaments@2x.png" LogicalName="Tsukimichi.assets.ui.ornaments@2x.png" />
    <EmbeddedResource Include="assets\ui\banners\*.png" LogicalName="Tsukimichi.assets.ui.banners.%(Filename)%(Extension)" />
    <!--
      The hero-size medal atlas (Menphina's Medallion, docs/design/moon-v6/round5/gen_atlas.py): Ui\MedalAtlas.cs, layout
      in Core/Ui/MedalLayout.cs, medals.json beside them as the build-time reference.
    -->
    <EmbeddedResource Include="assets\ui\medals.png" LogicalName="Tsukimichi.assets.ui.medals.png" />
    <EmbeddedResource Include="assets\ui\medals@2x.png" LogicalName="Tsukimichi.assets.ui.medals@2x.png" />
    <!--
      The giver-portrait atlas (1.15, docs/design/v7/ui/1.15/silhouettes/gen_portrait_atlas.py): the race silhouettes, the
      moon disc and Full's plate shade. Ui\PortraitAtlas.cs, layout in Core/Ui/PortraitAtlasLayout.cs, portraits.json beside.
    -->
    <EmbeddedResource Include="assets\ui\portraits.png" LogicalName="Tsukimichi.assets.ui.portraits.png" />
    <EmbeddedResource Include="assets\ui\portraits@2x.png" LogicalName="Tsukimichi.assets.ui.portraits@2x.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped data files only; Data\ also holds source (LuminaCatalogLoader.cs) that must not be copied to the output. -->
    <Content Include="Data\**" Exclude="Data\**\*.cs" CopyToOutputDirectory="PreserveNewest" />
    <!--
      The theme glyph sets' atlases (1.16 T5, docs/design/v7/themes/ATLAS-CONTRACT.md): one folder per set, loaded from
      disk only for the sets in use (Ui\Themes\ThemeAtlasCache.cs), so new sets never grow the DLL. Medallion's stay embedded.
      metrics.json is the build's record for the tests and reviewers; the plugin never reads it, so it does not ship.
    -->
    <Content Include="assets\ui\themes\**\*.png;assets\ui\themes\**\*.json" Exclude="assets\ui\themes\**\metrics.json" CopyToOutputDirectory="PreserveNewest" />
    <!--
      The release pictures of What's new (1.22, spec-1.22 W2, Option B): assets\whatsnew\<version>\<theme>.jpg, six per
      release, 1120 x 440. Loaded from disk one at a time while the popup is open (Ui\ReleaseArtTexture.cs); a missing
      file is no picture.
    -->
    <Content Include="assets\whatsnew\**\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <!--
      The quest-giver photos (feature plan v7 F4; the portrait pack, shipped with the plugin since the release after
      1.22): assets\portraits\manifest.json and one 128 px PNG per photo, written by Tsukimichi.DataGen (portrait-pack
      with bundle, docs/data/portrait-pack.md). Read at start (Game\BundledPortraitLoader.cs); Garland Tools renders, credit Celes.
    -->
    <Content Include="assets\portraits\*.png;assets\portraits\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <!--
      Moonfall's art set (plan v9 G8, Core/Moonfall/Art/MoonfallAtlas.cs): atlas.json, atlas.png, atlas@2x.png and sky.png,
      and the levels' background scenes in scenes\ (<scene>.png 800 x 600, <scene>@2x.png). Loaded from disk only while
      the Moonfall window is open (Ui\MoonfallArtTextures.cs), so a new art set ships by replacing these files.
    -->
    <Content Include="assets\moonfall\*.png;assets\moonfall\atlas.json;assets\moonfall\scenes\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The frame kits' frames and badges (1.17 T11, ATLAS-CONTRACT.md §7): one folder per kit, loaded only while a set is composed in it. -->
    <Content Include="assets\ui\kits\**\*.png;assets\ui\kits\**\*.json" Exclude="assets\ui\kits\**\metrics.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Packaged as images\icon.png, where Dalamud looks for a plugin's icon inside the zip; assets\icon.png stays the source. -->
    <Content Include="..\assets\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\assets\icon.png')" />
  </ItemGroup>

</Project>
