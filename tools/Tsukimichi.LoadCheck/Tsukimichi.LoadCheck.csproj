<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Load check (CI): loads the built plugin outside the game and, in every UI language, reads each localized label the
    UI keeps in a static field (LocText, LocArray, LocCache<T>) and runs every UI type's static constructor. A throw
    there stops the plugin loading in the game (the 1.1 Help window's card list without its icons), which the unit
    tests, referencing Core and GameData only, cannot see. Exits non-zero on any failure. Never shipped.

    Windows-only like the plugin (net10.0-windows, x64). Dalamud's assemblies are not copied: they are compiled against
    and resolved at run time from the same folder Dalamud.NET.Sdk builds the plugin against (DALAMUD_HOME, else
    XIVLauncher's Hooks\dev).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tsukimichi.LoadCheck</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The same resolution as Dalamud.NET.Sdk (Sdk.props): DALAMUD_HOME wins, else XIVLauncher's dev hooks. -->
  <PropertyGroup>
    <DalamudLibPath>$(APPDATA)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)\</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Tsukimichi\Tsukimichi.csproj" />
    <ProjectReference Include="..\..\Tsukimichi.Core\Tsukimichi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Where Program resolves Dalamud's assemblies at run time when DALAMUD_HOME is not set. -->
    <AssemblyMetadata Include="DalamudLibPath" Value="$(DalamudLibPath)" />
  </ItemGroup>

</Project>
