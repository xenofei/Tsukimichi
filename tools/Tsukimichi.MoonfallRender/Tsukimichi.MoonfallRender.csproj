<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Moonfall's offline renderer (runtime art, "check by looking"): runs the plugin's own Moonfall window under a headless
    ImGui (Dalamud's cimgui) and rasterizes its draw lists to a PNG, so the in-play board can be compared with the
    approved design (docs/design/v9/rich2/screens/hud-*) without the game. The game's textures and fonts are read from
    the player's install through Lumina (TSUKIMICHI_GAME_PATH); nothing is written but the PNGs asked for. Never shipped.

    Windows-only like the plugin (net10.0-windows, x64). Dalamud's assemblies are compiled against and resolved at run
    time from the folder the plugin is built against (DALAMUD_HOME, else XIVLauncher's Hooks\dev), as the load check does.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Tsukimichi.MoonfallRender</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <DalamudLibPath>$(APPDATA)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)\</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Tsukimichi\Tsukimichi.csproj" />
    <ProjectReference Include="..\..\Tsukimichi.Core\Tsukimichi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lumina" Version="7.7.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The ImGui native library the bindings load from the application's folder. -->
    <None Include="$(DalamudLibPath)cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(DalamudLibPath)cimgui.dll')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where Program resolves Dalamud's assemblies at run time when DALAMUD_HOME is not set. -->
    <AssemblyMetadata Include="DalamudLibPath" Value="$(DalamudLibPath)" />
  </ItemGroup>

</Project>
