{
  "key": "astrologian-orrery",
  "name": "Astrologian's Orrery",
  "note": "Approved after the supervisor's round 2. Hero tiers 96 and 128 draw hero/ (the engraved hatching on the lit moons); 48 and 64 draw mid/ (the row tier's smooth tone, no hatching), never the one-file composites' media query. Each sprite is layered in gen.py composite()'s order: face under, the Astrolabe frame for the state's urgency tier, face over, then the badge (ring, seat, glyph). Ready on another job's empty seats tint the kit's white seat mask with each role's enamel (gen.py ROLE; the Hand seat takes Medallion's Hand enamel, GlyphTokens.Medallion.HandHex).",
  "root": "docs/design/v7/themes/astrologian-orrery",
  "dest": "Tsukimichi/assets/ui/themes/astrologian-orrery",
  "palette": "dawn",
  "kit": "astrolabe",
  "faces": {
    "hero": {"under": "{tier}/{state}.svg", "over": "{tier}/{state}.over.svg"},
    "row": {"under": "row/{state}.svg", "over": "row/{state}.over.svg"}
  },
  "tiers": {
    "48": "mid",
    "64": "mid",
    "96": "hero",
    "128": "hero"
  },
