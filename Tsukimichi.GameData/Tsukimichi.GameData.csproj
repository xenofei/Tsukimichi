<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tsukimichi.GameData</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tsukimichi.Core\Tsukimichi.Core.csproj" />
  </ItemGroup>

  <!--
    Lumina is private so it does not flow to the plugin project: there, Dalamud.NET.Sdk supplies Lumina and Lumina.Excel
    from the Dalamud dev folder (same assembly identity, Version=7.0.0.0) and nothing must be shipped next to the plugin.
    Standalone consumers (Tests, DataGen) reference the packages themselves.
  -->
  <ItemGroup>
    <PackageReference Include="Lumina" Version="7.7.1" PrivateAssets="all" />
    <PackageReference Include="Lumina.Excel" Version="7.5.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
